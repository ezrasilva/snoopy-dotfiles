{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/Pictures/snoopy-day.png",
    "width": 30,
    "height": 14,
    "padding": { "top": 1, "right": 3 }
  },
  "display": { "separator": "  ", "color": { "keys": "red", "title": "blue" } },
  "modules": [
    "title",
    "break",
    { "type": "os",        "key": "󰣇 os     " },
    { "type": "kernel",    "key": " kernel " },
    { "type": "wm",        "key": " wm     " },
    { "type": "terminal",  "key": " term   " },
    { "type": "shell",     "key": " shell  " },
    { "type": "uptime",    "key": "󰔛 uptime " },
    { "type": "memory",    "key": "󰍛 mem    " },
    "break",
    "colors"
  ]
}
