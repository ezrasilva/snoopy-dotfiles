# gerado por tools/gen-colors.py (snoopy-night)
[global]
    monitor = 0
    follow = mouse
    width = (260, 360)
    origin = top-right
    offset = (14, 56)
    padding = 12
    horizontal_padding = 14
    frame_width = 3
    corner_radius = 14
    gap_size = 8
    font = JetBrainsMono Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 6
    progress_bar_height = 12
    icon_position = left
    max_icon_size = 48
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1c2136"
    foreground = "#f5ecd7"
    frame_color = "#56608a"
    timeout = 4

[urgency_normal]
    background = "#1c2136"
    foreground = "#f5ecd7"
    frame_color = "#ef5b4f"
    highlight = "#6aa9e8"
    timeout = 6

[urgency_critical]
    background = "#4a2f3b"
    foreground = "#f5ecd7"
    frame_color = "#ff9f55"
    timeout = 0
